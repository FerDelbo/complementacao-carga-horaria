# Copie este arquivo para ".env" e ajuste os valores (se quiser).
# O .env NUNCA vai para o GitHub (coloque no .gitignore).
# Ele é lido por DOIS lugares: o docker-compose.yml (cria o banco)
# e o backend/db.js (conecta no banco). Por isso os valores sempre batem.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=aluno
DB_PASSWORD=senha123
DB_NAME=hospital
# senha do root do MySQL dentro do container (só para administração)
DB_ROOT_PASSWORD=root123
